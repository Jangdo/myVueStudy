# API 베이스 URL (브라우저에서 호출하는 호스트:포트)
#
# 권장: aiscm-api-gateway 경유 — docker compose 전체 기동 시 게이트웨이가 호스트 8081에 노출됩니다.
# Ai Teaming 브라우저(axios/fetch)도 동일 베이스를 사용합니다. 미설정 시 코드 폴백 http://127.0.0.1:8081
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
#
# 대안: aiscm-common-service 직접 연결 — Gradle 등으로 common만 로컬 기동할 때(기본 server.port 8082).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8082
#
# 게이트웨이 globalcors 에 프론트 origin 허용 — 예: application.yml allowedOrigins (localhost:3000, 127.0.0.1:3000)
# NEXT_PUBLIC_AITEAMING_API_TIER=local
# AITEAMING_SERVER_FETCH_URL=http://127.0.0.1:8083
